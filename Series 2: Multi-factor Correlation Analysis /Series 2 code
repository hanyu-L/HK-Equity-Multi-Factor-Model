#################### 2.3.4 Sector neutralisation and market capitalisation #######################
##################################################################################################
def cross_section_wls_neutralize(base_df, factor_name):
    # base_df：完整当月截面，全程不删行
    df_full = base_df.copy()
    df_full["market_cap"] = pd.to_numeric(df_full["market_cap"], errors="coerce")
    df_full[factor_name] = pd.to_numeric(df_full[factor_name], errors="coerce")
    df_full["ln_market_cap"] = np.log(df_full["market_cap"].clip(lower=100000))

    # 仅临时提取回归可用样本，不修改原表
    reg_data = df_full.dropna(subset=["market_cap", factor_name, "industry"]).copy()
    if len(reg_data) < 20:
        df_full[f"{factor_name}_neu"] = df_full[factor_name]
        return df_full

    # 行业哑变量
    ind_dummies = pd.get_dummies(reg_data["industry"], prefix="ind", drop_first=True).astype(float)
    X_base = pd.concat([ind_dummies, reg_data[["ln_market_cap"]]], axis=1)
    X_base = X_base.loc[:, X_base.std() > 1e-10]

    y = reg_data[factor_name].astype(float)
    w = reg_data["market_cap"].astype(float)
    resid_series = pd.Series(np.nan, index=df_full.index)

    # 三层回归兜底
    try:
        X = sm.add_constant(X_base)
        mod = sm.WLS(y, X, weights=w, missing="drop")
        fit = mod.fit()
        resid_series.loc[reg_data.index] = fit.resid
    except np.linalg.LinAlgError:
        try:
            X_s = sm.add_constant(reg_data[["ln_market_cap"]].astype(float))
            mod_s = sm.WLS(y, X_s, weights=w, missing="drop")
            fit_s = mod_s.fit()
            resid_series.loc[reg_data.index] = fit_s.resid
        except:
            resid_series = df_full[factor_name]

    df_full[f"{factor_name}_neu"] = resid_series
    return df_full

# ---------------------- 全局预处理 ----------------------
id_columns = ["ts_code", "trade_date", "fiscal_type", "industry", "close", "turnover", "market_cap", "open", "high", "low", "volume"]
