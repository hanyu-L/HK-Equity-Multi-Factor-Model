# ====================== 1. 读取四张原始财务数据表 ======================
# 利润表、资产负债表、现金流量表、预计算财务指标表
df_income = pd.read_csv("hk_income.csv")
df_balance = pd.read_csv("hk_balancesheet.csv")
df_cashflow = pd.read_csv("hk_cashflow.csv")
df_indicator = pd.read_csv("hk_indicator.csv")

# 修复：end_date为8位数字字符串 20190630，强制指定格式转换，杜绝1970偏移错误
finance_df_list = [df_income, df_balance, df_cashflow, df_indicator]
for df in finance_df_list:
