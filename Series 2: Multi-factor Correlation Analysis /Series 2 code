# ====================== 4. PIT时点匹配函数：单只股票+单截面，筛选披露日前已发布财报 ======================
def get_latest_disclosed_fin(stock_code, cross_dt, fin_df):
    """
    PIT时点匹配核心函数，规避未来函数
    参数：
        stock_code: 个股代码 ts_code
        cross_dt: 当月月末调仓截面日期（datetime）
        fin_df: 合并后的全量财务总表 df_all_fin
    返回：
        最新一期已披露财报单行DataFrame；无符合条件财报返回空DataFrame
    """
    # 筛选当前股票全部财报记录
    stock_all_fin = fin_df[fin_df["ts_code"] == stock_code].copy()
    if len(stock_all_fin) == 0:
        return pd.DataFrame()

    # 仅保留披露时间早于/等于调仓截面日的财报，禁止使用未发布财报
    valid_fin_data = stock_all_fin[stock_all_fin["std_report_date"] <= cross_dt]
    if len(valid_fin_data) == 0:
        return pd.DataFrame()

    # 按财报截止日end_date倒序，取最新一期有效财报
    latest_fin = valid_fin.sort_values(by="end_date", ascending=False).iloc[0:1]
    return latest_fin

# ====================== 5. 滚动计算TTM基础财务指标（核心：适配港股年报/半年报混合披露） ======================
def calc_ttm_metrics(single_stock_fin):
    single_stock_fin = single_stock_fin.sort_values(by="end_date", ascending=True).reset_index(drop=True)

    ttm_col_list = [
        "rev_ttm", "net_profit_ttm", "net_profit_deduct_ttm", "gross_profit_ttm", "ocf_ttm",
        "total_equity_avg", "total_asset_avg", "ebit_ttm", "invest_cap_ttm"
    ]
    for col in ttm_col_list:
        single_stock_fin[col] = np.nan

    # 内部安全读取行字段，无后缀
    def get_row_safe(r, col):
        v = r.get(col, np.nan)
        if pd.isna(v) or str(v).strip() == "":
            return np.nan
        return float(v)

    for idx, row in single_stock_fin.iterrows():
        current_end = row["end_date"]
        current_type = row["fiscal_type"]
        window_start = current_end - pd.DateOffset(months=12)
        window_fin_data = single_stock_fin[
            (single_stock_fin["end_date"] > window_start) &
            (single_stock_fin["end_date"] <= current_end)
        ]

        # 原生无后缀字段读取
        rev_inc = get_row_safe(row, "Operating_revenue")
        net_profit_inc = get_row_safe(row, "Profit_attributable_to_equity_holders")
        deduct_profit = get_row_safe(row, "holder_profit")
        gross_inc = get_row_safe(row, "Gross_profit")
        ocf_cf = get_row_safe(row, "netcash_operate")
        int_exp = get_row_safe(row, "Interest_expense")
        tax_exp = get_row_safe(row, "Income_tax_expense")
        equity_bal = get_row_safe(row, "total_parent_equity")
        asset_bal = get_row_safe(row, "Total_assets")
        liab_bal = get_row_safe(row, "Total_liabilities")
        cash_bal = get_row_safe(row, "Cash_and_cash_equivalent")

        print(f"【{row['ts_code']} {current_end.date()}】营收:{rev_inc},净利润:{net_profit_inc}")

        if current_type == "annual":
            single_stock_fin.loc[idx, "rev_ttm"] = rev_inc
            single_stock_fin.loc[idx, "net_profit_ttm"] = net_profit_inc
            single_stock_fin.loc[idx, "net_profit_deduct_ttm"] = deduct_profit
            single_stock_fin.loc[idx, "gross_profit_ttm"] = gross_inc
            single_stock_fin.loc[idx, "ocf_ttm"] = ocf_cf

        elif current_type in ["semi", "quarter"]:
            last_year_same_period = single_stock_fin[
                (single_stock_fin["end_date"] == current_end - pd.DateOffset(years=1)) &
                (single_stock_fin["fiscal_type"] == current_type)
            ]
            last_year_annual = single_stock_fin[
                (single_stock_fin["end_date"] == current_end - pd.DateOffset(years=1)) &
                (single_stock_fin["fiscal_type"] == "annual")
            ]
            if len(last_year_same_period) > 0 and len(last_year_annual) > 0:
                ly_semi_row = last_year_same_period.iloc[0]
                ly_annual_row = last_year_annual.iloc[0]

                ly_rev = get_row_safe(ly_annual_row, "Operating_revenue") - get_row_safe(ly_semi_row, "Operating_revenue")
                ly_np = get_row_safe(ly_annual_row, "Profit_attributable_to_equity_holders") - get_row_safe(ly_semi_row, "Profit_attributable_to_equity_holders")
                ly_deduct = get_row_safe(ly_annual_row, "holder_profit") - get_row_safe(ly_semi_row, "holder_profit")
                ly_gross = get_row_safe(ly_annual_row, "Gross_profit") - get_row_safe(ly_semi_row, "Gross_profit")
                ly_ocf = get_row_safe(ly_annual_row, "netcash_operate") - get_row_safe(ly_semi_row, "netcash_operate")

                single_stock_fin.loc[idx, "rev_ttm"] = rev_inc + ly_rev
                single_stock_fin.loc[idx, "net_profit_ttm"] = net_profit_inc + ly_np
                single_stock_fin.loc[idx, "net_profit_deduct_ttm"] = deduct_profit + ly_deduct
                single_stock_fin.loc[idx, "gross_profit_ttm"] = gross_inc + ly_gross
                single_stock_fin.loc[idx, "ocf_ttm"] = ocf_cf + ly_ocf

        # 平均净资产、平均总资产
        if idx > 0:
            prev_row = single_stock_fin.iloc[idx - 1]
            prev_equity = get_row_safe(prev_row, "total_parent_equity")
            prev_asset = get_row_safe(prev_row, "Total_assets")
            single_stock_fin.loc[idx, "total_equity_avg"] = (equity_bal + prev_equity) / 2
            single_stock_fin.loc[idx, "total_asset_avg"] = (asset_bal + prev_asset) / 2

        # EBIT、投入资本
        ebit = net_profit_inc + int_exp + tax_exp
        invest_cap = liab_bal + equity_bal - cash_bal
        single_stock_fin.loc[idx, "ebit_ttm"] = ebit
        single_stock_fin.loc[idx, "invest_cap_ttm"] = invest_cap

    print("单股票TTM计算抽样：")
    print(single_stock_fin[["ts_code","end_date","fiscal_type","rev_ttm","net_profit_ttm"]].head())
    return single_stock_fin

# 批量对全市场个股执行TTM计算
fin_ttm_result_list = []
for code, stock_fin_group in df_all_fin.groupby("ts_code"):
    stock_ttm_df = calc_ttm_metrics(stock_fin_group)
    fin_ttm_result_list.append(stock_ttm_df)
df_fin_ttm = pd.concat(fin_ttm_result_list, ignore_index=True)

print("✅ TTM滚动财务指标计算完成，全局抽样：")
print(df_fin_ttm[["ts_code","end_date","rev_ttm","net_profit_ttm"]].head(20))

# ====================== 6. 逐月度截面匹配财报 + 批量计算全部财务因子 ======================
monthly_fin_output = []
# 遍历每一个月末调仓截面日期
for cross_dt in cross_date_list:
    print(f"正在处理截面：{cross_dt.date()}")

    # 1. 获取当前截面当日全市场个股 + 对应总市值
    cross_stock_df = df_price_raw[df_price_raw["trade_date"] == cross_dt].copy()
    cap_mapping = dict(zip(cross_stock_df["ts_code"], cross_stock_df["market_cap"]))
    stock_pool = cross_stock_df["ts_code"].unique()

    # 循环单只股票处理
    for stock_code in stock_pool:
        # 调用修复后的PIT函数
        latest_fin_df = get_latest_disclosed_fin(stock_code, cross_dt, df_fin_ttm)

        # 情况1：无任何已披露财报，全部财务因子填充NaN
        if len(latest_fin_df) == 0:
            base_row = {
                "ts_code": stock_code,
                "trade_date": cross_dt,
                "fiscal_type": "no_fin"
            }
            factor_list = [
                # 3.1 估值因子
                "EP_ttm", "EPcut_ttm", "BP", "SP_ttm", "PE", "PB", "PCF", "PS", "PEG",
                # 3.2 TTM同比成长因子
                "Sales_G_ttm", "Profit_G_ttm", "OCF_G_ttm", "ROE_G_ttm",
                # 3.2 半年同比成长因子
                "Sales_G_6m", "Profit_G_6m", "OCF_G_6m", "ROE_G_6m",
                # 3.6 财务质量因子
                "roe_ttm", "roe_6m_YoY", "roa_ttm", "roa_YoY", "gpm_ttm",
                "gpm_semi_YoY", "cfo_to_np_ttm", "roic_ttm"
            ]
            for fac in factor_list:
                base_row[fac] = np.nan
            monthly_fin_output.append(base_row)
            continue

        # 情况2：存在有效财报，提取单行财报数据
        fin_row = latest_fin_df.iloc[0]
        market_cap = cap_mapping.get(stock_code, np.nan)
        curr_fiscal_type = fin_row["fiscal_type"]
        out_row = {
            "ts_code": stock_code,
            "trade_date": cross_dt,
            "fiscal_type": curr_fiscal_type
        }

        # 封装安全读取字段，无后缀
        def get_safe(col):
            val = fin_row.get(col, np.nan)
            if pd.isna(val):
                return np.nan
            return float(val)

        # 基础财务指标提取
        net_profit_ttm = get_safe("net_profit_ttm")
        net_profit_deduct_ttm = get_safe("net_profit_deduct_ttm")
        equity_bal = get_safe("total_parent_equity")
        rev_ttm = get_safe("rev_ttm")
        ocf_ttm = get_safe("ocf_ttm")
        avg_equity = get_safe("total_equity_avg")
        avg_asset = get_safe("total_asset_avg")
        gross_profit_ttm = get_safe("gross_profit_ttm")
        ebit_ttm = get_safe("ebit_ttm")
        invest_cap_ttm = get_safe("invest_cap_ttm")

        # -------------------------- 3.1 估值因子计算 --------------------------
        if not pd.isna(market_cap) and market_cap != 0:
            out_row["EP_ttm"] = net_profit_ttm / market_cap
            out_row["EPcut_ttm"] = net_profit_deduct_ttm / market_cap
            out_row["BP"] = equity_bal / market_cap
            out_row["SP_ttm"] = rev_ttm / market_cap
        else:
            out_row["EP_ttm"] = np.nan
            out_row["EPcut_ttm"] = np.nan
            out_row["BP"] = np.nan
            out_row["SP_ttm"] = np.nan

        out_row["PE"] = market_cap / net_profit_ttm if (not pd.isna(net_profit_ttm) and net_profit_ttm != 0) else np.nan
        out_row["PB"] = market_cap / equity_bal if (not pd.isna(equity_bal) and equity_bal != 0) else np.nan
        out_row["PCF"] = market_cap / ocf_ttm if (not pd.isna(ocf_ttm) and ocf_ttm != 0) else np.nan
        out_row["PS"] = market_cap / rev_ttm if (not pd.isna(rev_ttm) and rev_ttm != 0) else np.nan

        # -------------------------- 3.2 TTM同比成长因子 --------------------------
        last_year_fin = df_fin_ttm[
            (df_fin_ttm["ts_code"] == stock_code) &
            (df_fin_ttm["end_date"] == fin_row["end_date"] - pd.DateOffset(years=1))
        ]
        if len(last_year_fin) > 0:
            ly_r = last_year_fin.iloc[0]
            ly_rev_ttm = ly_r.get("rev_ttm", np.nan)
            ly_np_ttm = ly_r.get("net_profit_ttm", np.nan)
            ly_ocf_ttm = ly_r.get("ocf_ttm", np.nan)
            ly_roe_ttm = ly_r.get("roe_ttm", np.nan)

            out_row["Sales_G_ttm"] = (rev_ttm / ly_rev_ttm) - 1 if (not pd.isna(ly_rev_ttm) and ly_rev_ttm != 0) else np.nan
            out_row["Profit_G_ttm"] = (net_profit_ttm / ly_np_ttm) - 1 if (not pd.isna(ly_np_ttm) and ly_np_ttm != 0) else np.nan
            out_row["OCF_G_ttm"] = (ocf_ttm / ly_ocf_ttm) - 1 if (not pd.isna(ly_ocf_ttm) and ly_ocf_ttm != 0) else np.nan
            out_row["ROE_G_ttm"] = (get_safe("roe_ttm") / ly_roe_ttm) - 1 if (not pd.isna(ly_roe_ttm) and ly_roe_ttm != 0) else np.nan
        else:
            out_row["Sales_G_ttm"] = np.nan
            out_row["Profit_G_ttm"] = np.nan
            out_row["OCF_G_ttm"] = np.nan
            out_row["ROE_G_ttm"] = np.nan

        # PEG
        out_row["PEG"] = out_row["PE"] / out_row["Sales_G_ttm"] if (not pd.isna(out_row["Sales_G_ttm"]) and out_row["Sales_G_ttm"] != 0) else np.nan

        # -------------------------- 半年同比成长因子 --------------------------
        last_semi_fin = df_fin_ttm[
            (df_fin_ttm["ts_code"] == stock_code) &
            (df_fin_ttm["end_date"] == fin_row["end_date"] - pd.DateOffset(years=1)) &
            (df_fin_ttm["fiscal_type"] == curr_fiscal_type)
        ]
        if curr_fiscal_type in ["semi", "quarter"] and len(last_semi_fin) > 0:
            ly_semi_r = last_semi_fin.iloc[0]
            curr_rev_semi = get_safe("Operating_revenue")
            ly_rev_semi = ly_semi_r.get("Operating_revenue", np.nan)
            curr_np_semi = get_safe("Profit_attributable_to_equity_holders")
            ly_np_semi = ly_semi_r.get("Profit_attributable_to_equity_holders", np.nan)
            curr_ocf_semi = get_safe("netcash_operate")
            ly_ocf_semi = ly_semi_r.get("netcash_operate", np.nan)
            curr_roe6 = get_safe("roe_6m_YoY")
            ly_roe6 = ly_semi_r.get("roe_6m_YoY", np.nan)

            out_row["Sales_G_6m"] = (curr_rev_semi / ly_rev_semi) - 1 if (not pd.isna(ly_rev_semi) and ly_rev_semi != 0) else np.nan
            out_row["Profit_G_6m"] = (curr_np_semi / ly_np_semi) - 1 if (not pd.isna(ly_np_semi) and ly_np_semi != 0) else np.nan
            out_row["OCF_G_6m"] = (curr_ocf_semi / ly_ocf_semi) - 1 if (not pd.isna(ly_ocf_semi) and ly_ocf_semi != 0) else np.nan
            out_row["ROE_G_6m"] = (curr_roe6 / ly_roe6) - 1 if (not pd.isna(ly_roe6) and ly_roe6 != 0) else np.nan
        else:
            out_row["Sales_G_6m"] = np.nan
            out_row["Profit_G_6m"] = np.nan
            out_row["OCF_G_6m"] = np.nan
            out_row["ROE_G_6m"] = np.nan

        # -------------------------- 3.6 财务质量因子计算 --------------------------
        out_row["roe_ttm"] = net_profit_ttm / avg_equity if (not pd.isna(avg_equity) and avg_equity != 0) else np.nan
        out_row["roa_ttm"] = net_profit_ttm / avg_asset if (not pd.isna(avg_asset) and avg_asset != 0) else np.nan
        out_row["gpm_ttm"] = gross_profit_ttm / rev_ttm if (not pd.isna(rev_ttm) and rev_ttm != 0) else np.nan
        out_row["cfo_to_np_ttm"] = ocf_ttm / net_profit_ttm if (not pd.isna(net_profit_ttm) and net_profit_ttm != 0) else np.nan
        out_row["roic_ttm"] = ebit_ttm / invest_cap_ttm if (not pd.isna(invest_cap_ttm) and invest_cap_ttm != 0) else np.nan

        # 半年同比质量指标
        if curr_fiscal_type in ["semi", "quarter"] and len(last_semi_fin) > 0:
            ly_semi_r = last_semi_fin.iloc[0]
            curr_roe6 = get_safe("roe_6m_YoY")
            ly_roe6 = ly_semi_r.get("roe_6m_YoY", np.nan)
            curr_roa6 = get_safe("roa_YoY")
            ly_roa6 = ly_semi_r.get("roa_YoY", np.nan)
            curr_gross = get_safe("Gross_profit")
            curr_rev_semi = get_safe("Operating_revenue")
            ly_gross = ly_semi_r.get("Gross_profit", np.nan)
            ly_rev_semi = ly_semi_r.get("Operating_revenue", np.nan)

            out_row["roe_6m_YoY"] = (curr_roe6 / ly_roe6) - 1 if (not pd.isna(ly_roe6) and ly_roe6 != 0) else np.nan
            out_row["roa_YoY"] = (curr_roa6 / ly_roa6) - 1 if (not pd.isna(ly_roa6) and ly_roa6 != 0) else np.nan

            if (not pd.isna(curr_rev_semi) and curr_rev_semi != 0) and (not pd.isna(ly_rev_semi) and ly_rev_semi != 0):
                curr_margin = curr_gross / curr_rev_semi
                ly_margin = ly_gross / ly_rev_semi
                out_row["gpm_semi_YoY"] = (curr_margin / ly_margin) - 1 if ly_margin != 0 else np.nan
            else:
                out_row["gpm_semi_YoY"] = np.nan
        else:
            out_row["roe_6m_YoY"] = np.nan
            out_row["roa_YoY"] = np.nan
            out_row["gpm_semi_YoY"] = np.nan

        monthly_fin_output.append(out_row)

# 拼接全部月度截面财务原始因子
