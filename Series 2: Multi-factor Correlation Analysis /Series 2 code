# ====================== 2. MAD去极值函数（单因子横截面） ======================
def mad_winsorize(series, n_mad=3):
    """
    MAD中位数绝对偏差去极值
    series: 单月横截面因子序列
    n_mad: 偏离中位数几倍MAD截断，默认3倍
    """
    data = series.dropna()
    median = np.median(data)
    mad = np.median(np.abs(data - median))
    if mad == 0:
        return series
    upper = median + n_mad * mad
    lower = median - n_mad * mad
    # 截断极值
    return series.clip(lower=lower, upper=upper)

# ====================== 3. Z-score横截面标准化函数 ======================
def cross_section_zscore(series):
    """单月横截面标准化，均值0，标准差1"""
    data = series.dropna()
    mean = np.mean(data)
    std = np.std(data)
    if std == 0:
        return series - mean
    return (series - mean) / std

