factor_result = []
for fac in factor_list:
    ic_list = []
    long_short_ret_list = []
    # 按月横截面分组
    for dt, group in df_test.groupby("trade_date"):
        # 过滤样本过少、因子空值过多的截面
        total_stock = len(group)
        valid_fac_num = group[fac].notna().sum()
        if total_stock < 50 or valid_fac_num < 30:
            continue
        
        # 1. 月度IC：仅使用非空样本计算相关系数
        sub_group = group.dropna(subset=[fac, ret_col])
        if len(sub_group) < 20:
            continue
        ic = sub_group[[fac, ret_col]].corr().iloc[0, 1]
        ic_list.append(ic)

        # 2. 五层分层，添加duplicates="drop"容错
        try:
            sub_group["quantile"] = pd.qcut(
                sub_group[fac].rank(method="first"),
                q=5,
                labels=[1,2,3,4,5],
                duplicates="drop"
            )
            quint_ret = sub_group.groupby("quantile")[ret_col].mean()
            # 确保存在1、5分位再计算多空
            if {1,5}.issubset(set(quint_ret.index)):
                ls_ret = quint_ret[5] - quint_ret[1]
                long_short_ret_list.append(ls_ret)
        except Exception as e:
            continue

    # 无有效月度数据直接标记空
    if len(ic_list) == 0:
        factor_result.append({
            "factor_name": fac,
            "avg_IC": np.nan,
            "IC_IR": np.nan,
            "avg_long_short_ret": np.nan
        })
        continue

    # 汇总时序指标
    ic_mean = np.mean(ic_list)
    ic_std = np.std(ic_list)
    ic_ir = ic_mean / ic_std if ic_std != 0 else np.nan
    avg_ls_ret = np.mean(long_short_ret_list) if len(long_short_ret_list) > 0 else np.nan

    factor_result.append({
        "factor_name": fac,
        "avg_IC": ic_mean,
        "IC_IR": ic_ir,
        "avg_long_short_ret": avg_ls_ret
    })

