print("【Robust Test 3: Performance in Different Market Regimes】")
regime_splits = [
    ("2019-01-01","2020-12-31","Bear Market 2019-2020"),
    ("2021-01-01","2023-12-31","Sideways 2021-2023"),
    ("2024-01-01","2025-12-31","Uptrend 2024-2025")
]
for start, end, name in regime_splits:
    df_sub = df_all[(df_all["announce_date"] >= start) & (df_all["announce_date"] <= end)]
    bt_sub = backtest_general(df_sub, "composite_opt_icir", TOP_N_STOCK)
