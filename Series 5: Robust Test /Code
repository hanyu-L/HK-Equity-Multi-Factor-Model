# ========== 测试2：因子衰减测试｜延迟1期、2期调仓 ==========
print("\n" + "="*60)
print("【Robust Test 2: Factor Decay Test — Lag Rebalance】")
# lag=0原始；lag=1延迟一期；lag=2延迟两期
df_lag0 = df_all.copy()
bt_lag0 = backtest_general(df_lag0, "composite_opt_icir", TOP_N_STOCK)

# 构造滞后信号（平移一期announce_date截面模拟延迟调仓）
cross_list = [cross for _, cross in df_all.groupby("announce_date")]
lag1_cross = cross_list[:-1]
lag2_cross = cross_list[:-2]
df_lag1 = pd.concat(lag1_cross)
df_lag2 = pd.concat(lag2_cross)

bt_lag1 = backtest_general(df_lag1, "composite_opt_icir", TOP_N_STOCK)
bt_lag2 = backtest_general(df_lag2, "composite_opt_icir", TOP_N_STOCK)

lag_bt = {
    "Lag0 (Original)": bt_lag0,
    "Lag1 Rebalance": bt_lag1,
    "Lag2 Rebalance": bt_lag2
}
for lab, data in lag_bt.items():
    p = calc_perf(data)
    print(f"{lab:<16} | {p}")

plt.figure(figsize=(12,6))
for name, data in lag_bt.items():
    plt.plot(data["date"], data["net_value"], label=name, linewidth=1.8)
plt.title("Factor Decay: Performance with Delayed Rebalance")
plt.xlabel("Date")
plt.ylabel("Net Asset Value")
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()
plt.show()


