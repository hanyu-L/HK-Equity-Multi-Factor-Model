def backtest_general(df_input: pd.DataFrame, composite_col: str, top_n: int):
    """通用回测函数，支持自定义选股数量，复用原有逻辑"""
    net = [1.0]
    date_list = []
    hold_stock_set = set()

    for trade_dt, cross_df in df_input.groupby("announce_date"):
        date_list.append(trade_dt)
        valid = cross_df.dropna(subset=[composite_col, "forward_return"])
        if len(valid) < top_n:
            net.append(net[-1])
            continue
        valid_sort = valid.sort_values(composite_col, ascending=False)
        select = valid_sort.head(top_n)["ts_code"].tolist()
        turnover = len(set(select) ^ hold_stock_set) / max(len(select), top_n)
        raw_ret = valid_sort[valid_sort["ts_code"].isin(select)]["forward_return"].mean()
        cost = turnover * (TRANSACTION_COST_RATE + HONGKONG_STAMP_TAX)
        net_ret = raw_ret - cost
        net.append(net[-1] * (1 + net_ret))
        hold_stock_set = set(select)

    bt_df = pd.DataFrame({"date": date_list, "net_value": net[1:]})
    bt_df["date"] = pd.to_datetime(bt_df["date"])
    return bt_df


def calc_perf(bt_df, rf=0.02):
    """快速计算指标，复用半年度口径"""
    df = bt_df.copy().sort_values("date")
    df["period_ret"] = df["net_value"].pct_change()
    df = df.dropna()
    if len(df) < 3:
        return {}
    total_years = (df["date"].iloc[-1] - df["date"].iloc[0]).days / 365.0
    total_return = df["net_value"].iloc[-1] / df["net_value"].iloc[0] - 1
    annual_return = (1 + total_return) ** (1 / total_years) - 1

    rolling_max = df["net_value"].cummax()
    drawdown = (df["net_value"] / rolling_max) - 1
    max_dd = drawdown.min()

    period_vol = df["period_ret"].std()
    annual_vol = period_vol * np.sqrt(2)
    sharpe = (annual_return - rf) / annual_vol if annual_vol > 1e-8 else np.nan

    res = {
        "AnnualReturn": round(annual_return,4),
        "MaxDD": round(max_dd,4),
        "AnnVol": round(annual_vol,4),
        "Sharpe": round(sharpe,4)
    }
    return res


