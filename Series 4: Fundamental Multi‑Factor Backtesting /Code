# =====================【追加：修正适配半年度调仓的绩效指标函数】=====================
def calculate_performance_metrics_halfyear(bt_df, risk_free=0.02, period_year=0.5):
    """
    适配半年度调仓回测（持仓周期≈0.5年）
    :param bt_df: date, net_value
    :param risk_free: 无风险利率 2%
    :param period_year: 单次调仓持有年限 0.5（半年）
    """
    df = bt_df.copy().sort_values("date")
    # 区间收益率（每期调仓收益）
    df["period_ret"] = df["net_value"].pct_change()
    df = df.dropna()

    total_periods = len(df)
    total_return = df["net_value"].iloc[-1] / df["net_value"].iloc[0] - 1

    # 按调仓周期年化
    annual_scale = 1 / period_year
    annual_return = (1 + total_return) ** (annual_scale / total_periods * total_periods) - 1
    # 等价简化：(期末/期初)^(1/总年限)-1
    total_years = (df["date"].iloc[-1] - df["date"].iloc[0]).days / 365.0
    annual_return = (df["net_value"].iloc[-1] / df["net_value"].iloc[0]) ** (1 / total_years) - 1

    # 最大回撤
    rolling_max = df["net_value"].cummax()
    drawdown = (df["net_value"] / rolling_max) - 1
    max_drawdown = drawdown.min()

    # 周期波动率 -> 年化波动率
    period_vol = df["period_ret"].std()
    annual_vol = period_vol * np.sqrt(annual_scale)
    sharpe = (annual_return - risk_free) / annual_vol if annual_vol > 1e-8 else np.nan

    metrics = {
        "Total Return": round(total_return, 4),
        "Annualized Return": round(annual_return, 4),
        "Max Drawdown": round(max_drawdown, 4),
        "Annual Volatility": round(annual_vol, 4),
        "Sharpe Ratio": round(sharpe, 4)
    }
    return metrics

