#################### Equal-weighted Synthesis ####################
##################################################################
# ====================== 方法1：等权合成 ======================
print("\n===== 方法1：等权复合因子 =====")
df_m1 = df_raw.copy()
pca_val = PCA(n_components=1)
val_mat = df_m1[val_factors].dropna()
df_m1["val_pca"] = np.nan
df_m1.loc[val_mat.index, "val_pca"] = pca_val.fit_transform(val_mat)[:, 0]
df_m1["comp_equal"] = df_m1["val_pca"] + df_m1["gpm_semi_YoY"]
