import pandas as pd
import numpy as np
from sklearn.decomposition import PCA
import warnings
from scipy.optimize import minimize
warnings.filterwarnings("ignore")

# ====================== 前置全局初始化 ======================
df_raw = pd.read_csv("valid_factor_for_corr.csv", encoding="utf-8-sig")
id_cols = ["ts_code", "trade_date", "industry", "next_month_return"]
factor_cols = ["BP", "PB", "gpm_semi_YoY"]

# 单因子全周期固定绩效
factor_perf = pd.DataFrame({
    "factor_name": ["BP", "PB", "gpm_semi_YoY"],
    "avg_IC": [-0.065152, 0.062149, -0.018228],
    "IC_IR": [-0.468905, 0.401035, -0.150635],
    "abs_IR": [abs(-0.468905), abs(0.401035), abs(-0.150635)]
})
val_factors = ["BP", "PB"]
quality_factors = ["gpm_semi_YoY"]
model_result = []

# 通用绩效计算函数
def calc_factor_performance(df, comp_col):
    ic_list = []
    ls_ret_list = []
    for dt, group in df.groupby("trade_date"):
        if len(group) < 30:
            continue
        sub = group.dropna(subset=[comp_col, "next_month_return"])
        if len(sub) < 20:
            continue
        ic = sub[[comp_col, "next_month_return"]].corr().iloc[0, 1]
        ic_list.append(ic)
        try:
            sub["quantile"] = pd.qcut(sub[comp_col].rank(method="first"), q=5, labels=[1,2,3,4,5], duplicates="drop")
            quint_mean = sub.groupby("quantile")["next_month_return"].mean()
            if {1,5}.issubset(set(quint_mean.index)):
                ls_ret = quint_mean[5] - quint_mean[1]
                ls_ret_list.append(ls_ret)
        except Exception:
            continue
    if len(ic_list) == 0:
        return np.nan, np.nan, np.nan
    ic_mean = np.mean(ic_list)
    ic_std = np.std(ic_list)
    ic_ir = ic_mean / ic_std if ic_std != 0 else np.nan
    avg_ls = np.mean(ls_ret_list) if len(ls_ret_list) > 0 else np.nan
    return round(ic_mean, 4), round(ic_ir, 4), round(avg_ls, 4)

